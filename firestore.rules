rules_version = '2';
// Reglas de seguridad: copia todo este texto en Firebase > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && email() == 'josuetapianefrologo@gmail.com'; }
    function acceso() { return get(/databases/$(database)/documents/config/acceso).data; }
    function isEditor() { return isAdmin() || (signedIn() && email() in acceso().editores); }
    function isReader() { return isEditor() || (signedIn() && email() in acceso().lectores); }

    match /config/acceso { allow read: if isReader(); allow write: if isAdmin(); }
    match /pacientes/{id} { allow read: if isReader(); allow write: if isEditor(); }
    // El historial no se puede editar ni borrar: queda como registro permanente.
    match /historial/{id} { allow read: if isReader(); allow create: if isEditor(); allow update, delete: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
